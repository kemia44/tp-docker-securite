# ---------- Étape 1 : construction ----------
FROM node:22.21.1-alpine3.22 AS build

WORKDIR /app

# D'abord les dépendances (pour profiter du cache)
COPY package*.json ./
RUN npm ci

# Puis le code, et la compilation
COPY . .
RUN npm run build


# ---------- Étape 2 : production ----------
FROM node:22.21.1-alpine3.22 AS production

# Outil de service + utilisateur dédié (en root, donc AVANT le USER)
RUN npm install -g serve serve@14.2.8 \
  && addgroup -S appgroup \
  && adduser -S -G appgroup appuser

WORKDIR /app

# On ne récupère QUE le résultat du build, en le donnant à appuser
COPY --from=build --chown=appuser:appgroup /app/dist ./dist

USER appuser

EXPOSE 3000
CMD ["serve", "-s", "dist"]
