FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
COPY . .

# Étapes qui ont besoin de root : AVANT le USER
RUN npm install \
  && npm install -g serve \
  && npm run build \
  && rm -fr node_modules

# Création de l'utilisateur et attribution du dossier
RUN addgroup -S appgroup \
  && adduser -S -G appgroup appuser \
  && chown -R appuser:appgroup /app

# À partir d'ici, plus de root
USER appuser

EXPOSE 3000
CMD ["serve", "-s", "dist"]
